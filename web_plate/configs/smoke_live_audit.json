{
  "extends": "smoke.json",
  "experiment_name": "toponader-smoke-live-audit",
  "method": {
    "architecture_adaptation": true,
    "architecture_review_mode": "every_round",
    "uncertainty_sampling": true,
    "diversity_sampling": true
  },
  "architecture": {
    "candidate_count": 2,
    "fully_train_count": 2,
    "candidate_retry_limit": 3,
    "zero_cost_enabled": true,
    "zero_cost_keep_count": 2
  },
  "agents": {
    "enabled": true,
    "model": "gpt-5.6-sol",
    "base_url": "https://api.openai.com/v1",
    "timeout_seconds": 300,
    "max_retries": 3
  }
}
