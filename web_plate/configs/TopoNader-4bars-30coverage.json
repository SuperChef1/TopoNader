      "upper_tolerance": 0.02,
      "lower_bound_enabled": false,
      "lower_bound": null
    },
    "elite_local_search": {
      "enabled": true,
      "elite_count": 5,
      "particle_weights": [
        0.4,
        0.2,
        0.16,
        0.12,
        0.12
      ],
      "selected_weights": [
        0.4,
        0.2,
        0.2,
        0.1,
        0.1
      ],
      "small_position_radius": 20.0,
      "small_angle_radius": 5.0,
      "small_width_radius": 10.0,
      "medium_position_radius": 40.0,
      "medium_angle_radius": 10.0,
      "medium_width_radius": 20.0,
      "single_parameter_fraction": 0.6,
      "single_bar_two_parameter_fraction": 0.25,
      "candidates_per_elite": 100
    },
    "grid_nx": 55,
    "grid_ny": 90,
    "grid_step": 10.0,
    "grid_x0": -5.0,
    "grid_y0": 445.0,
    "rod_width_min": 1.0,
    "rod_width_max": 500.0
  },
  "trigger": {
    "enabled": true,
    "patience": 3,
    "max_architecture_age": 10,
    "min_pairwise_accuracy": 0.6,
    "min_kendall_tau": 0.2,
    "max_topk_regret": 0.2,
    "min_feedback_samples": 4,
    "min_audit_interval": 5
